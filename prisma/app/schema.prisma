// ============================================================================
// DB APLIKASI (reporthub) — READ-WRITE, milik kita. TERPISAH dari SIMGOS.
// ============================================================================
// Boleh migrasi/ubah struktur di sini (ini bukan SIMGOS). Prisma 7: koneksi
// runtime lewat driver adapter (src/server/db/app.client.ts), URL untuk CLI ada
// di prisma.app.config.ts.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/app"
}

datasource db {
  provider = "mysql"
}

/// Peran aplikasi (RBAC dinamis). `admin` = superadmin: akses penuh seluruh sistem,
/// melewati semua pengecekan izin. `isSystem` melindungi peran bawaan dari
/// dihapus/di-rename. Lihat docs/rbac/01-model-data.md.
model Role {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  isSystem     Boolean  @default(false) @map("is_system")
  isSuperadmin Boolean  @default(false) @map("is_superadmin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

/// Grant izin per-peran. Kehadiran baris = izin diberikan. `moduleKey`/`action`
/// divalidasi terhadap katalog modul di kode (src/server/rbac/modules.ts).
model RolePermission {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleKey String   @map("module_key")
  action    String   @default("view")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roleId, moduleKey, action])
  @@index([roleId])
  @@map("role_permissions")
}

/// Pengguna aplikasi. Password disimpan sebagai hash bcrypt (tidak pernah plaintext).
/// Peran memakai FK `roleId` (menggantikan enum lama). Kolom profil diisi lewat
/// modul Master › Pengguna. NIK & tanggal lahir = PII sensitif.
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? @unique
  /// Hash bcrypt sandi LOKAL. NULL untuk pengguna sumber SIMGOS (kredensial di SIMGOS).
  passwordHash String? @map("password_hash")

  /// Sumber autentikasi: "LOCAL" (verifikasi hash lokal) | "SIMGOS" (verifikasi ke aplikasi.pengguna).
  authSource String @default("LOCAL") @map("auth_source")
  /// LOGIN persis di `aplikasi.pengguna` (server SIMGOS) untuk pengguna authSource=SIMGOS.
  simgosLogin String? @map("simgos_login")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  // Profil
  nik           String?   @unique
  nip           String?
  gelarDepan    String?   @map("gelar_depan")
  name          String
  gelarBelakang String?   @map("gelar_belakang")
  tanggalLahir  DateTime? @map("tanggal_lahir") @db.Date
  agama         String?
  phone         String?

  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  ttdTersimpan  FormRmTtdPetugas[]

  @@index([roleId])
  @@map("users")
}

/// Jejak audit aksi administratif (buat/ubah user, ganti grant, reset sandi, dll).
/// Disimpan di DB aplikasi (bukan SIMGOS). Tanpa PII penuh / sandi di metadata.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  action    String
  targetId  String?  @map("target_id")
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

/// Bukti Pelayanan yang DIISI SENDIRI oleh petugas (bukan data SIMGOS).
/// Tindakan ditarik dari SIMGOS (`layanan.tindakan_medis`) lalu bisa disunting;
/// hasil akhirnya (form + snapshot tindakan) disimpan sebagai JSON di sini,
/// satu per episode (NOPEN). SIMGOS tetap READ-ONLY — penyimpanan hanya di sini.
model BuktiPelayanan {
  id         String   @id @default(cuid())
  /// NOPEN (nomor pendaftaran / episode) — satu bukti per episode.
  nopen      String   @unique
  norm       String?
  namaPasien String?  @map("nama_pasien")
  kategori   String?
  ruang      String?
  /// Isi form + daftar tindakan (editable) sebagai JSON.
  data       Json
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("bukti_pelayanan")
}

/// Formulir Rekam Medis (RM) yang DIISI SENDIRI oleh admisi/petugas (bukan data
/// SIMGOS). Generik: satu baris per (NOPEN, jenis) — mis. jenis "edukasi" (RM.21),
/// "ringkasan" (RM.01), "consent" (RM.03). Isi form disimpan sebagai JSON.
/// SIMGOS tetap READ-ONLY — penyimpanan hanya di sini.
model FormRm {
  id         String   @id @default(cuid())
  /// NOPEN (nomor pendaftaran / episode).
  nopen      String
  /// Jenis form RM: "edukasi" | "ringkasan" | "consent" | …
  jenis      String
  norm       String?
  namaPasien String?  @map("nama_pasien")
  ruang      String?
  /// Isi form sebagai JSON.
  data       Json
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([nopen, jenis])
  @@map("form_rm")
}

/// Isian Form RM v2 (registri form di kode: src/features/form-rm/registry.ts).
/// DDL manual: scripts/db/form-rm.sql. Satu baris per isian; unik
/// (formKode, subjek, urutan). `rev` naik di setiap tulis (konkurensi optimistis).
/// Identitas pasien = snapshot SIMGOS yang diambil server (bukan dari klien).
model FormRmIsian {
  id               String    @id @default(cuid()) @db.VarChar(30)
  formKode         String    @map("form_kode") @db.VarChar(20)
  formVersi        Int       @map("form_versi") @db.SmallInt
  /// NOPEN atau nomor KUNJUNGAN sesuai cakupan form.
  subjek           String    @db.VarChar(30)
  nopen            String    @db.VarChar(20)
  kunjungan        String?   @db.VarChar(30)
  urutan           Int       @default(1) @db.SmallInt
  norm             String    @db.VarChar(20)
  namaPasien       String    @map("nama_pasien") @db.VarChar(191)
  ruang            String?   @db.VarChar(191)
  /// DRAF | FINAL | BATAL
  status           String    @default("DRAF") @db.VarChar(10)
  rev              Int       @default(1)
  /// Isi form; tanda tangan hanya berupa referensi "ttd:<id>".
  data             Json
  /// Path kolom yang terisi otomatis dari SIMRS.
  asal             Json?
  dibuatOlehId     String?   @map("dibuat_oleh_id") @db.VarChar(191)
  diubahOlehId     String?   @map("diubah_oleh_id") @db.VarChar(191)
  difinalkanOlehId String?   @map("difinalkan_oleh_id") @db.VarChar(191)
  difinalkanAt     DateTime? @map("difinalkan_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  ttd                FormRmTtd[]
  revisi             FormRmRevisi[]
  /// Ada = isian dibuat sebelum pasien terdaftar (nopen "" sampai ditautkan).
  identitasSementara FormRmIdentitasSementara?

  @@unique([formKode, subjek, urutan], map: "uq_form_rm_isian")
  @@index([nopen], map: "idx_form_rm_isian_nopen")
  @@index([norm], map: "idx_form_rm_isian_norm")
  @@index([formKode, status, updatedAt], map: "idx_form_rm_isian_status")
  @@map("form_rm_isian")
}

/// Gambar tanda tangan (PNG dinormalkan server). Sekali tulis, tak pernah diubah.
model FormRmTtd {
  id           String      @id @default(cuid()) @db.VarChar(30)
  isianId      String      @map("isian_id") @db.VarChar(30)
  slot         String      @db.VarChar(60)
  png          Bytes       @db.MediumBlob
  sha256       String      @db.Char(64)
  ukuran       Int
  dibuatOlehId String?     @map("dibuat_oleh_id") @db.VarChar(191)
  createdAt    DateTime    @default(now()) @map("created_at")
  isian        FormRmIsian @relation(fields: [isianId], references: [id], onDelete: Restrict, map: "fk_form_rm_ttd_isian")

  @@unique([isianId, sha256], map: "uq_form_rm_ttd")
  @@map("form_rm_ttd")
}

/// TTD tersimpan milik petugas (pengguna login) untuk dipakai ulang; satu per
/// (pengguna, jenis TTD/PARAF). Hanya pemiliknya yang membaca/memakai. Dipakai =
/// PNG disalin ke `form_rm_ttd` isian. DDL manual: scripts/db/form-rm.sql.
model FormRmTtdPetugas {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  /// TTD | PARAF
  jenis     String   @db.VarChar(10)
  png       Bytes    @db.MediumBlob
  sha256    String   @db.Char(64)
  ukuran    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_form_rm_ttd_petugas_user")

  @@unique([userId, jenis], map: "uq_form_rm_ttd_petugas")
  @@map("form_rm_ttd_petugas")
}

/// Snapshot isian di setiap transisi status. APPEND-ONLY; `hash` = HMAC-SHA256
/// berantai per isian (lihat server/modules/form-rm/isian.segel.ts).
model FormRmRevisi {
  id          String      @id @default(cuid()) @db.VarChar(30)
  isianId     String      @map("isian_id") @db.VarChar(30)
  rev         Int
  /// FINALKAN | BUKA_KOREKSI | BATALKAN
  aksi        String      @db.VarChar(20)
  status      String      @db.VarChar(10)
  data        Json
  alasan      String?     @db.VarChar(500)
  olehId      String?     @map("oleh_id") @db.VarChar(191)
  olehNama    String?     @map("oleh_nama") @db.VarChar(191)
  hash        String      @db.Char(64)
  hashSebelum String?     @map("hash_sebelum") @db.Char(64)
  /// Diisi aplikasi (ikut disegel), bukan default DB.
  createdAt   DateTime    @map("created_at")
  isian       FormRmIsian @relation(fields: [isianId], references: [id], onDelete: Restrict, map: "fk_form_rm_revisi_isian")

  @@unique([isianId, rev], map: "uq_form_rm_revisi")
  @@map("form_rm_revisi")
}

/// Identitas sementara isian yang dibuat sebelum pasien terdaftar di SIMRS (mis.
/// triase IGD). Isian belum tertaut: subjek "~<token>", nopen & norm kosong.
/// Tetap disimpan setelah ditautkan sebagai jejak. DDL: scripts/db/form-rm.sql.
model FormRmIdentitasSementara {
  isianId           String      @id @map("isian_id") @db.VarChar(30)
  sebutan           String      @db.VarChar(60)
  /// L | P | "" (tidak diketahui)
  jenisKelamin      String      @default("") @map("jenis_kelamin") @db.VarChar(1)
  perkiraanUmur     String      @default("") @map("perkiraan_umur") @db.VarChar(30)
  ciri              String      @default("") @db.VarChar(300)
  ditautkanAt       DateTime?   @map("ditautkan_at")
  ditautkanOlehId   String?     @map("ditautkan_oleh_id") @db.VarChar(191)
  ditautkanOlehNama String?     @map("ditautkan_oleh_nama") @db.VarChar(191)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  isian             FormRmIsian @relation(fields: [isianId], references: [id], onDelete: Restrict, map: "fk_form_rm_identitas_sementara_isian")

  @@map("form_rm_identitas_sementara")
}

/// Penetapan pejabat per ruangan (Kepala Instalasi, Kepala Ruangan, Ketua Tim, dll).
/// Ruangan dibaca dari SIMGOS (`master.ruangan`, READ-ONLY); penetapan ini kita
/// simpan di sini. `ruanganId` = `master.ruangan.ID` (9 digit) untuk satu ruangan,
/// atau "inst:1|2|3" (per JENIS_KUNJUNGAN) untuk Kepala Instalasi tingkat instalasi.
/// Kepala Ruangan menjadi penandatangan Bukti Pelayanan.
model RuanganPejabat {
  id        String   @id @default(cuid())
  /// master.ruangan.ID (ruangan) atau "inst:1|2|3" (instalasi).
  ruanganId String   @unique @map("ruangan_id")
  /// Snapshot nama & kategori ruangan (memudahkan tampil tanpa query SIMGOS ulang).
  nama      String?
  kategori  String?
  /// { kepalaInstalasi?:{nama,nip}, kepalaRuangan?:{nama,nip}, ketuaTim?:{nama,nip} }
  data      Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ruangan_pejabat")
}

/// Pemetaan ruang rawat inap SIMGOS → jenis pelayanan RL 3.2 (SIRS 6) =
/// `master.refrl.ID`. Pengganti `master.rl32_ruangan_revisi` SIMGOS yang berisi
/// ID SMF (bukan ruangan) sehingga SP LaporanRL32RuanganRevisi selalu kosong;
/// SIMGOS tetap READ-ONLY. `rlId` null = ruangan sengaja tidak dilaporkan; tanpa
/// baris = belum dipetakan. `pisahDpjp` = pasien dikelompokkan menurut SMF DPJP
/// kunjungan (Rl32SmfPeta), SMF tanpa pemetaan ikut `rlId`. DDL: scripts/db/laporan-rl.sql.
model Rl32RuanganPeta {
  ruanganId      String   @id @map("ruangan_id") @db.VarChar(10)
  rlId           Int?     @map("rl_id")
  pisahDpjp      Boolean  @default(false) @map("pisah_dpjp")
  /// Snapshot nama ruangan saat dipetakan (jejak tetap terbaca).
  ruanganNama    String   @map("ruangan_nama") @db.VarChar(191)
  diubahOlehId   String?  @map("diubah_oleh_id") @db.VarChar(191)
  diubahOlehNama String?  @map("diubah_oleh_nama") @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("rl32_ruangan_peta")
}

/// SMF dokter (`master.pegawai.SMF` milik DPJP kunjungan, via `master.dokter.NIP`)
/// → jenis pelayanan RL 3.2. Hanya dipakai di ruangan ber-`pisahDpjp`.
model Rl32SmfPeta {
  smfId          Int      @id @map("smf_id") @db.SmallInt
  rlId           Int      @map("rl_id")
  smfNama        String   @map("smf_nama") @db.VarChar(191)
  diubahOlehId   String?  @map("diubah_oleh_id") @db.VarChar(191)
  diubahOlehNama String?  @map("diubah_oleh_nama") @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("rl32_smf_peta")
}

// ============================================================================
// MODUL INVENTARISASI BARANG — data aset RSUD (READ-WRITE). Tabel `inv_*`.
// DDL manual: scripts/db/inventaris.sql + migrate-inventaris.mjs. Model di sini
// HARUS sinkron dengan DDL tersebut. Lihat docs/inventarisasi-barang/BLUEPRINT.md.
// ============================================================================

/// Satuan barang (Unit, Buah, Set, …).
model InvSatuan {
  id        String   @id @default(cuid())
  nama      String   @unique
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barang InvBarang[]
  item   InvItem[]

  @@map("inv_satuan")
}

/// Kondisi barang (Baik/Rusak Ringan/Rusak Berat). `tone` = warna badge (success/warning/danger).
model InvKondisi {
  id        String   @id @default(cuid())
  nama      String
  kode      String   @unique
  tone      String   @default("neutral")
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barang            InvBarang[]
  pemeliharaanHasil InvPemeliharaan[]
  checklistPeriksa  InvChecklistPeriksa[]

  @@map("inv_kondisi")
}

/// Sumber anggaran perolehan (DAU/DAK/Hibah/APBD/…).
model InvSumberAnggaran {
  id        String   @id @default(cuid())
  nama      String
  singkatan String   @unique
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barang InvBarang[]

  @@map("inv_sumber_anggaran")
}

/// Kategori/kelompok barang (Alat Kesehatan, Mebel, …).
model InvKategori {
  id        String   @id @default(cuid())
  nama      String   @unique
  kode      String?
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barang InvBarang[]
  item   InvItem[]

  @@map("inv_kategori")
}

/// Katalog jenis barang (master item). 1 item = 1 jenis; `namaKey` = nama ternormalkan (unik).
/// Unit fisik (InvBarang) menautkan `itemId` → agregasi lintas ruangan & nama baku konsisten.
model InvItem {
  id          String   @id @default(cuid())
  nama        String
  namaKey     String   @unique @map("nama_key")
  kategoriId  String?  @map("kategori_id")
  satuanId    String?  @map("satuan_id")
  spesifikasi String?  @db.Text
  aktif       Boolean  @default(true)
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  kategori InvKategori? @relation(fields: [kategoriId], references: [id], onDelete: SetNull)
  satuan   InvSatuan?   @relation(fields: [satuanId], references: [id], onDelete: SetNull)
  barang   InvBarang[]

  @@map("inv_item")
}

/// Ruangan/lokasi aset + penanggung jawab. `kodePrefix` dipakai auto-generate
/// kode barang (mis. ICU → ICU-001) & sebagai kop KIR.
model InvRuangan {
  id         String   @id @default(cuid())
  kodePrefix String   @unique @map("kode_prefix")
  nama       String
  pjNama     String?  @map("pj_nama")
  pjNip      String?  @map("pj_nip")
  urutan     Int      @default(0)
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  barang    InvBarang[]
  mutasiKe   InvMutasi[] @relation("MutasiKe")
  mutasiDari InvMutasi[] @relation("MutasiDari")
  checklistRun      InvChecklistRun[]
  publik     InvRuanganPublik?

  @@map("inv_ruangan")
}

/// Tautan publik (QR) daftar barang ruangan — `token` = kapabilitas acak
/// 192-bit (base64url 32 kar., kolom ascii_bin). DDL: scripts/db/inventaris-publik.sql.
model InvRuanganPublik {
  ruanganId  String   @id @map("ruangan_id")
  token      String   @unique @db.Char(32)
  aktif      Boolean  @default(true)
  dibuatOleh String?  @map("dibuat_oleh")
  diubahOleh String?  @map("diubah_oleh")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ruangan InvRuangan @relation(fields: [ruanganId], references: [id], onDelete: Cascade)

  @@map("inv_ruangan_publik")
}

/// Unit aset (1 baris = 1 unit fisik). `kodeBarang` unik = tag permanen.
model InvBarang {
  id               String    @id @default(cuid())
  kodeBarang       String    @unique @map("kode_barang")
  register         Int?
  nama             String
  itemId           String?   @map("item_id")
  merk             String?
  nomorSeri        String?   @map("nomor_seri")
  kategoriId       String?   @map("kategori_id")
  sumberAnggaranId String?   @map("sumber_anggaran_id")
  satuanId         String?   @map("satuan_id")
  kondisiId        String?   @map("kondisi_id")
  ruanganId        String    @map("ruangan_id")
  tahunPerolehan   Int?      @map("tahun_perolehan") @db.SmallInt
  tglPerolehan     DateTime? @map("tgl_perolehan") @db.Date
  harga            BigInt?
  statusAset       String    @default("AKTIF") @map("status_aset")
  fotoUrl          String?   @map("foto_url")
  keterangan       String?   @db.Text
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  item           InvItem?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  kategori       InvKategori?       @relation(fields: [kategoriId], references: [id], onDelete: SetNull)
  sumberAnggaran InvSumberAnggaran? @relation(fields: [sumberAnggaranId], references: [id], onDelete: SetNull)
  satuan         InvSatuan?         @relation(fields: [satuanId], references: [id], onDelete: SetNull)
  kondisi        InvKondisi?        @relation(fields: [kondisiId], references: [id], onDelete: SetNull)
  ruangan        InvRuangan         @relation(fields: [ruanganId], references: [id], onDelete: Restrict)
  pemeliharaan   InvPemeliharaan[]
  mutasi         InvMutasi[]
  checklistPeriksa InvChecklistPeriksa[]

  @@index([ruanganId])
  @@index([kondisiId])
  @@index([kategoriId])
  @@index([itemId])
  @@index([statusAset])
  @@index([tahunPerolehan])
  @@map("inv_barang")
}

/// Log pemeliharaan/pengecekan per unit.
model InvPemeliharaan {
  id                   String    @id @default(cuid())
  barangId             String    @map("barang_id")
  tanggal              DateTime  @db.Date
  jenis                String    @default("RUTIN")
  hasil                String?
  kondisiSesudahId     String?   @map("kondisi_sesudah_id")
  petugas              String?
  biaya                BigInt?
  catatan              String?   @db.Text
  jatuhTempoBerikutnya DateTime? @map("jatuh_tempo_berikutnya") @db.Date
  createdBy            String?   @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  barang         InvBarang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  kondisiSesudah InvKondisi? @relation(fields: [kondisiSesudahId], references: [id], onDelete: SetNull)

  @@index([barangId])
  @@index([tanggal])
  @@map("inv_pemeliharaan")
}

/// Riwayat mutasi (perpindahan lokasi) aset antar ruangan.
model InvMutasi {
  id            String   @id @default(cuid())
  barangId      String   @map("barang_id")
  dariRuanganId String?  @map("dari_ruangan_id")
  keRuanganId   String   @map("ke_ruangan_id")
  tanggal       DateTime @db.Date
  alasan        String?
  oleh          String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  barang      InvBarang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  dariRuangan InvRuangan? @relation("MutasiDari", fields: [dariRuanganId], references: [id], onDelete: SetNull)
  keRuangan   InvRuangan  @relation("MutasiKe", fields: [keRuanganId], references: [id], onDelete: Restrict)

  @@index([barangId])
  @@map("inv_mutasi")
}

/// Pelaksanaan checklist pemeliharaan berkala satu ruangan pada satu periode.
/// Isi checklist = daftar unit barang di ruangan itu (dari Master Barang).
/// Frekuensi: HARIAN | MINGGUAN | BULANAN.
model InvChecklistRun {
  id         String    @id @default(cuid())
  ruanganId  String    @map("ruangan_id")
  frekuensi  String    @default("HARIAN")
  periodeKey String    @map("periode_key")
  selesaiAt  DateTime? @map("selesai_at")
  selesaiBy  String?   @map("selesai_by")
  catatan    String?   @db.Text
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  ruangan InvRuangan            @relation(fields: [ruanganId], references: [id], onDelete: Cascade)
  periksa InvChecklistPeriksa[]

  @@unique([ruanganId, frekuensi, periodeKey])
  @@index([ruanganId])
  @@index([periodeKey])
  @@map("inv_checklist_run")
}

/// Hasil pemeriksaan satu unit barang dalam satu pelaksanaan checklist.
/// Baris ada = barang sudah diperiksa; `kondisiId` = status kondisi hasil periksa.
model InvChecklistPeriksa {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  barangId  String   @map("barang_id")
  kondisiId String?  @map("kondisi_id")
  catatan   String?  @db.Text
  checkedBy String?  @map("checked_by")
  checkedAt DateTime @default(now()) @map("checked_at")

  run     InvChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  barang  InvBarang       @relation(fields: [barangId], references: [id], onDelete: Cascade)
  kondisi InvKondisi?     @relation(fields: [kondisiId], references: [id], onDelete: SetNull)

  @@unique([runId, barangId])
  @@index([runId])
  @@index([barangId])
  @@map("inv_checklist_periksa")
}

/// Rekap Klaim BPJS — satu baris = satu entri klaim INA-CBG's / Rujukan Ambulans.
/// Uang disimpan dalam rupiah penuh (BigInt). Enum sebagai String (divalidasi Zod).
model KlaimKlaim {
  id               String    @id @default(cuid())
  nomorKlaim       String?   @map("nomor_klaim")
  jenisKlaim       String    @default("REGULER") @map("jenis_klaim")
  jenisLayanan     String    @default("RITL") @map("jenis_layanan")
  kategori         String    @default("INA_CBGS")
  bulanPelayanan   Int       @map("bulan_pelayanan") @db.TinyInt
  tahunPelayanan   Int       @map("tahun_pelayanan") @db.SmallInt
  jumlah           BigInt    @default(0)
  jumlahDiajukan   BigInt?   @map("jumlah_diajukan")
  jumlahKasus      Int?      @map("jumlah_kasus")
  tglMasukRekening DateTime? @map("tgl_masuk_rekening") @db.Date
  status           String    @default("SUBMITTED")
  refBa            String?   @map("ref_ba")
  catatan          String?   @db.Text
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  potongan KlaimPotongan[]

  @@index([tahunPelayanan])
  @@index([tahunPelayanan, bulanPelayanan])
  @@index([jenisKlaim])
  @@index([jenisLayanan])
  @@index([kategori])
  @@index([status])
  @@map("klaim_klaim")
}

/// Potongan / adjustment terhadap sebuah klaim (AAK, kelebihan bayar, cicilan, dll).
model KlaimPotongan {
  id           String    @id @default(cuid())
  klaimId      String    @map("klaim_id")
  jenis        String
  jumlah       BigInt    @default(0)
  cicilanKe    Int?      @map("cicilan_ke")
  totalCicilan Int?      @map("total_cicilan")
  refBa        String?   @map("ref_ba")
  deskripsi    String?   @db.Text
  tglTerapkan  DateTime? @map("tgl_terapkan") @db.Date
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  klaim KlaimKlaim @relation(fields: [klaimId], references: [id], onDelete: Cascade)

  @@index([klaimId])
  @@index([jenis])
  @@map("klaim_potongan")
}

// ============================================================================
// VERIFIKASI KLAIM BPJS — status & jejak verifikasi berkas klaim per NOPEN.
// SIMGOS tetap READ-ONLY; semua keputusan/koreksi/lampiran/paket disimpan di sini.
// DDL manual: scripts/db/verifikasi-klaim.sql + migrate-verifikasi-klaim.mjs.
// Model di sini HARUS sinkron dengan DDL tersebut. PRD: docs/PRD_Verifikasi_Klaim_BPJS.md.
// Enum = String (divalidasi Zod / konstanta modul). *OlehId = users.id pelaku.
// ============================================================================

/// Satu baris per episode klaim (NOPEN), dibuat saat keputusan pertama (lazy):
/// episode tanpa baris = BELUM_DIPERIKSA. `versi` = optimistic locking.
model KlaimVerifikasi {
  id               String    @id @default(cuid()) @db.VarChar(30)
  nopen            String    @unique @db.VarChar(20)
  norm             String?   @db.VarChar(20)
  namaPasien       String?   @map("nama_pasien") @db.VarChar(191)
  /// RI | IGD | RJ
  kategori         String    @db.VarChar(4)
  ruang            String?   @db.VarChar(191)
  /// Jam dinding SIMGOS (konvensi aplikasi: dibaca sebagai UTC).
  tglPulang        DateTime? @map("tgl_pulang") @db.DateTime(0)
  noSep            String?   @map("no_sep") @db.VarChar(40)
  status           String    @default("BELUM_DIPERIKSA") @db.VarChar(20)
  versi            Int       @default(1)
  /// Snapshot hasil cek otomatis terakhir (HasilCek).
  cek              Json?
  cekAt            DateTime? @map("cek_at")
  lolosRmOlehId    String?   @map("lolos_rm_oleh_id") @db.VarChar(191)
  lolosRmAt        DateTime? @map("lolos_rm_at")
  lolosKlaimOlehId String?   @map("lolos_klaim_oleh_id") @db.VarChar(191)
  lolosKlaimAt     DateTime? @map("lolos_klaim_at")
  finalOlehId      String?   @map("final_oleh_id") @db.VarChar(191)
  finalAt          DateTime? @map("final_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  riwayat     KlaimVerifikasiRiwayat[]
  tindakLanjut KlaimTindakLanjut[]
  koreksi     KlaimKoreksiKoding[]
  lampiran    KlaimLampiran[]
  paket       KlaimPaket?

  @@index([status])
  @@index([tglPulang])
  @@map("klaim_verifikasi")
}

/// Linimasa transisi & aksi verifikasi (siapa, kapan, dari→ke, catatan, rincian).
model KlaimVerifikasiRiwayat {
  id         String   @id @default(cuid()) @db.VarChar(30)
  nopen      String   @db.VarChar(20)
  aksi       String   @db.VarChar(40)
  dariStatus String?  @map("dari_status") @db.VarChar(20)
  keStatus   String?  @map("ke_status") @db.VarChar(20)
  /// Versi baris klaim_verifikasi SETELAH aksi.
  versi      Int
  catatan    String?  @db.Text
  data       Json?
  olehId     String?  @map("oleh_id") @db.VarChar(191)
  olehNama   String?  @map("oleh_nama") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at")

  verifikasi KlaimVerifikasi @relation(fields: [nopen], references: [nopen], onDelete: Cascade)

  @@index([nopen, createdAt])
  @@map("klaim_verifikasi_riwayat")
}

/// Item kurang per NOPEN → sasaran (DPJP/RUANGAN/PERAN). Tertutup otomatis saat
/// data SIMRS sudah lengkap (dicek ulang read-only).
model KlaimTindakLanjut {
  id              String    @id @default(cuid()) @db.VarChar(30)
  nopen           String    @db.VarChar(20)
  /// Kunci katalog aturan / "manual" / "koding".
  aturan          String    @db.VarChar(40)
  tahap           Int       @default(1) @db.TinyInt
  pesan           String    @db.VarChar(500)
  /// DPJP | RUANGAN | PERAN
  sasaranJenis    String    @map("sasaran_jenis") @db.VarChar(10)
  /// NIP / master.ruangan.ID / roles.key
  sasaranRef      String    @map("sasaran_ref") @db.VarChar(60)
  sasaranNama     String?   @map("sasaran_nama") @db.VarChar(191)
  /// OPEN | SELESAI | BATAL
  status          String    @default("OPEN") @db.VarChar(10)
  catatan         String?   @db.Text
  dibuatOlehId    String?   @map("dibuat_oleh_id") @db.VarChar(191)
  dibuatOlehNama  String?   @map("dibuat_oleh_nama") @db.VarChar(191)
  selesaiAt       DateTime? @map("selesai_at")
  /// OTOMATIS | MANUAL | BATAL
  selesaiCara     String?   @map("selesai_cara") @db.VarChar(10)
  selesaiOlehId   String?   @map("selesai_oleh_id") @db.VarChar(191)
  selesaiOlehNama String?   @map("selesai_oleh_nama") @db.VarChar(191)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  verifikasi KlaimVerifikasi @relation(fields: [nopen], references: [nopen], onDelete: Cascade)

  @@index([nopen])
  @@index([status, sasaranJenis, sasaranRef])
  @@map("klaim_tindak_lanjut")
}

/// Usulan koreksi koding oleh coder (TIDAK ditulis ke SIMGOS). SESUAI terdeteksi
/// otomatis saat diagnosa/prosedur SIMGOS sudah sama dengan usulan.
model KlaimKoreksiKoding {
  id             String    @id @default(cuid()) @db.VarChar(30)
  nopen          String    @db.VarChar(20)
  /// MENUNGGU_SIMRS | SESUAI | BATAL
  status         String    @default("MENUNGGU_SIMRS") @db.VarChar(16)
  usulan         Json
  simrsAwal      Json      @map("simrs_awal")
  catatan        String?   @db.Text
  /// Bukti log SIMGOS (OBJEK 21003) saat terdeteksi sesuai.
  bukti          Json?
  dibuatOlehId   String?   @map("dibuat_oleh_id") @db.VarChar(191)
  dibuatOlehNama String?   @map("dibuat_oleh_nama") @db.VarChar(191)
  sesuaiAt       DateTime? @map("sesuai_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  verifikasi KlaimVerifikasi @relation(fields: [nopen], references: [nopen], onDelete: Cascade)

  @@index([nopen])
  @@index([status])
  @@map("klaim_koreksi_koding")
}

/// Dokumen sisipan paket klaim (berkas fisik di volume storage, bukan BLOB DB).
model KlaimLampiran {
  id               String    @id @default(cuid()) @db.VarChar(30)
  nopen            String    @db.VarChar(20)
  namaBerkas       String    @map("nama_berkas") @db.VarChar(255)
  mime             String    @db.VarChar(100)
  ukuran           Int
  sha256           String    @db.Char(64)
  lokasi           String    @db.VarChar(500)
  halaman          Int?
  urutan           Int       @default(0)
  keterangan       String?   @db.VarChar(255)
  diunggahOlehId   String?   @map("diunggah_oleh_id") @db.VarChar(191)
  diunggahOlehNama String?   @map("diunggah_oleh_nama") @db.VarChar(191)
  createdAt        DateTime  @default(now()) @map("created_at")
  dihapusAt        DateTime? @map("dihapus_at")
  dihapusOlehId    String?   @map("dihapus_oleh_id") @db.VarChar(191)

  verifikasi KlaimVerifikasi @relation(fields: [nopen], references: [nopen], onDelete: Cascade)

  @@index([nopen])
  @@index([sha256])
  @@map("klaim_lampiran")
}

/// Paket klaim gabungan — satu per NOPEN (versi lama diganti; hash tiap versi di riwayat).
model KlaimPaket {
  id             String   @id @default(cuid()) @db.VarChar(30)
  nopen          String   @unique @db.VarChar(20)
  versi          Int      @default(1)
  /// DRAF | FINAL
  status         String   @default("DRAF") @db.VarChar(10)
  manifest       Json
  hash           String   @db.Char(64)
  halaman        Int      @default(0)
  ukuran         Int      @default(0)
  lokasi         String?  @db.VarChar(500)
  dibuatOlehId   String?  @map("dibuat_oleh_id") @db.VarChar(191)
  dibuatOlehNama String?  @map("dibuat_oleh_nama") @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  verifikasi KlaimVerifikasi @relation(fields: [nopen], references: [nopen], onDelete: Cascade)

  @@map("klaim_paket")
}

/// Notifikasi dalam aplikasi (GENERIK). Sasaran: USER (users.id) / NIP (users.nip) /
/// RUANGAN (akses ruangan SIMGOS) / PERAN (roles.key).
model Notifikasi {
  id           String   @id @default(cuid()) @db.VarChar(30)
  jenis        String   @db.VarChar(40)
  judul        String   @db.VarChar(191)
  pesan        String?  @db.VarChar(500)
  tautan       String?  @db.VarChar(500)
  sasaranJenis String   @map("sasaran_jenis") @db.VarChar(10)
  sasaranRef   String   @map("sasaran_ref") @db.VarChar(191)
  refTipe      String?  @map("ref_tipe") @db.VarChar(40)
  refId        String?  @map("ref_id") @db.VarChar(60)
  dibuatOlehId String?  @map("dibuat_oleh_id") @db.VarChar(191)
  createdAt    DateTime @default(now()) @map("created_at")

  baca NotifikasiBaca[]

  @@index([sasaranJenis, sasaranRef, createdAt])
  @@index([refTipe, refId])
  @@map("notifikasi")
}

/// Status baca notifikasi per pengguna (baris ada = sudah dibaca).
model NotifikasiBaca {
  notifikasiId String   @map("notifikasi_id") @db.VarChar(30)
  userId       String   @map("user_id") @db.VarChar(191)
  dibacaAt     DateTime @default(now()) @map("dibaca_at")

  notifikasi Notifikasi @relation(fields: [notifikasiId], references: [id], onDelete: Cascade)

  @@id([notifikasiId, userId])
  @@index([userId])
  @@map("notifikasi_baca")
}

/// Refresh token (rotasi). Yang disimpan HANYA hash token-nya, bukan token asli,
/// sehingga bocornya DB tidak langsung memberi token yang bisa dipakai.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent") @db.Text
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
