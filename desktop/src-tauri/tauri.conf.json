{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuditTrail RS BOLTIM",
  "mainBinaryName": "audittrail-rsboltim",
  "version": "1.0.0",
  "identifier": "id.go.boltimkab.rsud.audittrail",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "UPTD RSUD Bolaang Mongondow Timur",
    "copyright": "UPTD RSUD Bolaang Mongondow Timur",
    "category": "Medical",
    "shortDescription": "AuditTrail RS BOLTIM",
    "longDescription": "Jendela aplikasi untuk server ReportHub RSUD Bolaang Mongondow Timur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMkNENzAzRTE0QTJDN0QKUldSOUxFcmhBOWNzUEFKaGNzVWlKcllqN21VcC9XTjlHblVwS1BNRVlzUlJXUnJqbGx4T0ZHY0kK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
