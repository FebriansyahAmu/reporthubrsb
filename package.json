{
  "name": "reporthubrsb",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:simgos:generate": "prisma generate --schema prisma/simgos/schema.prisma",
    "db:simgos:pull": "prisma db pull --schema prisma/simgos/schema.prisma",
    "db:app:generate": "prisma generate --config prisma.app.config.ts",
    "db:app:push": "prisma db push --config prisma.app.config.ts",
    "postinstall": "prisma generate --schema prisma/simgos/schema.prisma && prisma generate --config prisma.app.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.24.0",
    "mariadb": "^3.5.3",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
