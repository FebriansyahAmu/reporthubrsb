# ============================================================================
# ReportHub RSB — Environment (SALIN ke .env, jangan commit .env)
# ============================================================================

# --- SIMGOS: READ-ONLY (HIGH ALERT) --------------------------------------
# User MySQL HANYA GRANT SELECT, EXECUTE (tanpa DDL/DML). Tanpa anchor DB —
# semua query wajib ter-kualifikasi (db.tabel / db.sp()).
DATABASE_URL_SIMGOS="mysql://USER:PASSWORD@HOST:3306/"
# SIMGOS_DEFAULT_DB="pendaftaran"

# Kunci rahasia hashing SIMGOS (Aplikasi\Password::$private_key) — untuk login
# via akun SIMGOS. Verifikasi = password_hash(hmac_sha256(pw, sha256hex(key))).
# Ambil nilai ASLI dari instalasi SIMGOS. Kosong = login akun SIMGOS tak akan cocok.
SIMGOS_PASSWORD_KEY="ambil-dari-simgos"

# --- DB Aplikasi (reporthub): milik kita, READ-WRITE. TERPISAH dari SIMGOS. --
# Menyimpan users, refresh token/sesi, audit trail, preset filter.
DATABASE_URL_APP="mysql://USER:PASSWORD@HOST:3306/reporthub"

# --- Auth (JWT access + refresh, cookie httpOnly) ---------------------------
# Secret acak kuat (mis. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
AUTH_ACCESS_SECRET="ganti-dengan-secret-acak"
AUTH_REFRESH_SECRET="ganti-dengan-secret-acak-berbeda"
# Sesi "tetap masuk": selama ada tab aplikasi terbuka, sesi disegarkan di latar
# (sebelum access habis) walau pengguna idle. Semua opsional.
# Masa access token (menit, default 15).
# AUTH_ACCESS_TTL_MIN="15"
# Masa refresh token (menit, default 60; bergeser tiap rotasi; min 2× access, maks
# 7 hari). Hanya terasa saat browser/PC ditutup atau tidur lebih lama dari ini.
# (AUTH_REFRESH_TTL_DAYS lama tidak dipakai lagi.)
# AUTH_REFRESH_TTL_MIN="60"
# Batas mutlak sesi sejak kata sandi dimasukkan (jam, default 12; 0 = tanpa batas;
# 1–72). Tidak diperpanjang penyegaran; peringatan 5 menit sebelumnya.
# SESI_MAKS_JAM="12"
# Keluar otomatis saat idle (PC bersama; default 0 = nonaktif; 5–480 menit).
# Klien: tanpa input di semua tab → peringatan 1 menit → draf disimpan → keluar.
# SESI_IDLE_MENIT="0"

# --- Penyimpanan berkas (Paket Klaim, foto barang Inventaris) ---------------
# Folder di disk, di luar `public` (dilayani hanya lewat route berizin).
# Default `<folder aplikasi>/storage`. Docker: folder host `./storage` di-mount
# ke `/app/storage` (docker-compose.yml; chown 1001:1001 sekali di server).
# STORAGE_DIR="/app/storage"

# --- Origin publik (tautan yang dibuka di luar sesi login) -------------------
# Dipakai untuk QR label ruangan (/ruang/<token>, Inventaris › KIR & BAST ›
# QR Publik). WAJIB origin murni http(s) TANPA path, yang bisa dijangkau HP
# pemindai (domain publik atau IP LAN). Kosong → jatuh ke SIGN_PUBLIC_ORIGIN;
# keduanya kosong → QR tidak bisa dibuat. Sengaja TIDAK diambil dari header
# Host request (cegah host-header injection).
# PUBLIC_APP_ORIGIN="https://reporthub.rsudboltim.go.id"

# --- Aplikasi desktop (Tauri): alamat server bawaan installer ----------------
# Dibaca HANYA oleh `npm run rilis` di folder desktop/ saat membangun installer
# (ditanam ke exe); server Next.js tidak memakainya. WAJIB origin murni http(s)
# tanpa path — idealnya nama host/IP tetap, karena PC terpasang memeriksa
# pembaruan ke alamat ini. Samakan dengan PUBLIC_APP_ORIGIN/SIGN_PUBLIC_ORIGIN
# server produksi (URL unduhan pembaruan dibuat dari situ). Bisa ditimpa per
# PC lewat berkas reporthub.json di folder pemasangan (docs/desktop-tauri.md).
# REPORTHUB_URL="https://reporthub.rsudboltim.go.id"
#
# Server https ber-sertifikat SELF-SIGNED (tidak dipercaya Windows): sidik SHA-256
# sertifikat server yang dipin aplikasi desktop (WebView2 & updater hanya
# menerima sertifikat ini). Pisah koma bila >1 (mis. saat pergantian
# sertifikat). Lihat sidik server: `npm run rilis -- --cek` di desktop/, lalu
# cocokkan di server: openssl x509 -in <cert.pem> -noout -fingerprint -sha256
# Kosongkan bila sertifikat server dari CA yang dipercaya.
# REPORTHUB_CERT_SHA256="<64 digit hex>"

# --- Form RM: kunci segel integritas revisi (WAJIB, min. 32 karakter) --------
# HMAC-SHA256 berantai atas setiap revisi isian (FINAL/koreksi/batal) — tanpa
# kunci ini, perubahan langsung di DB tidak bisa dideteksi. Tanpa nilai yang sah,
# finalisasi & pemeriksaan riwayat ditolak (503). JANGAN diganti setelah dipakai
# (segel lama tak bisa diverifikasi lagi). Bila dev & produksi memakai DB
# reporthub yang sama, nilainya HARUS sama. Buat sekali:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FORM_RM_KUNCI_INTEGRITAS="ganti-dengan-secret-acak-min-32-karakter"
